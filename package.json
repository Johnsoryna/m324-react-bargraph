{
  "name": "@johnsoryna/mybargraph",
  "version": "1.0.0",
  "description": "HorizontalBarGraph - eine einfache, animierte React-Balkenkomponente (Modul 324 DevOps)",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Johnny Leonhardt",
  "keywords": [
    "react",
    "component",
    "bargraph",
    "bar-graph",
    "progress",
    "m324"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Johnsoryna/m324-react-bargraph.git"
  },
